# Copy this file to .env for local development; the server loads it at startup. Anything set in the
# real environment (a host's settings, AI Studio's Secrets panel) takes precedence over .env.

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=""

# GOOGLE_MAPS_PLATFORM_KEY: Required for Google Maps Platform (Maps JS API, Advanced Markers, Routes API,
# and client-side Places discovery). This key is sent to the browser (see server.ts's injectRuntimeConfig),
# so it should be restricted by HTTP referrer to your site's origin in the Google Cloud Console.
GOOGLE_MAPS_PLATFORM_KEY=

# GOOGLE_MAPS_MAP_ID (Optional): The Map ID the pollen map uses for Advanced Markers. Create one under
# Google Maps Platform > Map Management. Without it the map uses Google's DEMO_MAP_ID placeholder,
# which is meant for trying things out rather than production. Injected at request time like the key.
GOOGLE_MAPS_MAP_ID=""

# GOOGLE_PLACES_SERVER_KEY (Optional): Used by /api/pollen-hotspots for its server-to-server Places API
# (New) Text Search call. Do NOT reuse an HTTP-referrer-restricted key here — Google rejects referrer
# restrictions on non-browser requests with a 403, since there's no Referer header to check. Restrict this
# key by IP address instead (or leave it API-restricted only), and make sure "Places API (New)" is enabled
# and billing is active on its project. If omitted, falls back to GOOGLE_MAPS_PLATFORM_KEY, which will
# typically 403 in production once that key is referrer-restricted as recommended above.
GOOGLE_PLACES_SERVER_KEY=""

# GOOGLE_POLLEN_API_KEY (Optional): Google Maps Pollen API key for live UPI index and species forecasts.
# If omitted, AllerScan automatically uses live Open-Meteo Air Quality & Weather API feeds.
GOOGLE_POLLEN_API_KEY=""

# TRUST_PROXY (Optional): How many proxy hops sit in front of the server. The rate limits key on the
# client's address, which Express only takes from X-Forwarded-For when told how many hops to trust.
# Leave unset locally (trusts none) and on Vercel (defaults to 1). The Dockerfile sets 1 for Cloud
# Run. Set 0 if clients connect to the server directly, or they can spoof their address.
TRUST_PROXY=""
